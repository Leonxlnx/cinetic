{
  "name": "cinetic-hyperframes-film",
  "private": true,
  "description": "cinetic starter for HyperFrames 0.8.79: one paused GSAP timeline on a beat grid.",
  "scripts": {
    "postinstall": "node setup.mjs",
    "preview": "npx -y hyperframes@0.8.79 preview",
    "lint": "npx -y hyperframes@0.8.79 lint .",
    "check": "npx -y hyperframes@0.8.79 check .",
    "snapshot": "npx -y hyperframes@0.8.79 snapshot . --at 1,2,3,4",
    "cues": "bash scripts/hf-finish.sh . --export-cues out/cues.json",
    "music": "node scripts/py.mjs scripts/audio/track.py music",
    "kit": "node scripts/py.mjs scripts/audio/kit.py render",
    "plan": "node scripts/py.mjs scripts/audio/plan.py",
    "audio": "node scripts/py.mjs scripts/audio/plan.py --quiet && node scripts/py.mjs scripts/audio/score.py --cues out/cues.json --score audio/score.json --out public/audio/soundtrack.wav --stems out/stems --json out/qa/score.json",
    "credits": "node scripts/py.mjs scripts/audio/credits.py",
    "listen": "node scripts/py.mjs scripts/audio/listen.py",
    "render:preview": "bash scripts/hf-finish.sh . out/preview.mp4 --preview",
    "render": "bash scripts/hf-finish.sh . out/film.mp4 --audio public/audio/soundtrack.wav"
  },
  "devDependencies": {
    "@fontsource-variable/inter": "5.3.0",
    "gsap": "3.14.2"
  }
}
